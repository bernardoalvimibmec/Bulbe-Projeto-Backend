@startuml
title Diagrama de Casos de Uso — API Bulbe Energia
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #2B6CB0
}

actor "Aplicação Frontend\n(Cliente Bulbe)" as Frontend
actor "Fonte de dados\nBulbe/CEMIG" as FonteDados
actor "Serviço de\nnotificações" as Notificacoes
actor "Sistema externo de\nhistórico de faturas" as HistoricoExterno

rectangle "Sistema — API Bulbe Energia" {
  usecase "UC001 — Criar conta\nou realizar primeiro acesso" as UC001
  usecase "UC002 — Autenticar usuário" as UC002
  usecase "UC003 — Encerrar sessão" as UC003
  usecase "UC004 — Consultar dados\ndo cliente" as UC004

  usecase "UC005 — Consultar usinas" as UC005
  usecase "UC006 — Consultar créditos\nde uma usina" as UC006
  usecase "UC007 — Consultar resumo\nde créditos das usinas" as UC007
  usecase "UC008 — Consultar\ndepoimentos públicos" as UC008

  usecase "UC009 — Consultar progresso\nda ativação" as UC009
  usecase "UC010 — Consultar etapas\nda ativação" as UC010
  usecase "UC011 — Configurar atualizações\nda ativação" as UC011

  usecase "UC012 — Consultar faturas" as UC012
  usecase "UC013 — Consultar situação\ndo pagamento" as UC013
  usecase "UC014 — Consultar etapas\ndo repasse" as UC014
  usecase "UC015 — Acessar histórico\nexterno de faturas" as UC015

  usecase "UC016 — Consultar\nnotificações" as UC016
  usecase "UC017 — Marcar notificação\ncomo lida" as UC017

  usecase "UC018 — Validar sessão\ne autorização" as UC018
  usecase "UC019 — Associar conta ao\ncliente elegível" as UC019
}

Frontend --> UC001
Frontend --> UC002
Frontend --> UC003
Frontend --> UC004
Frontend --> UC005
Frontend --> UC007
Frontend --> UC008
Frontend --> UC009
Frontend --> UC011
